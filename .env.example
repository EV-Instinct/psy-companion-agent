# ===== 模型（OpenAI 兼容端点）=====
# 不填 Key 时自动进入 mock 演示模式（界面与流程可跑通，回复为预置话术）
# 默认值走硅基流动 SiliconFlow；换阿里云百炼时改为：
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_MODEL=qwen-plus  VLM_MODEL=qwen-vl-plus  LLM_THINKING=off
# 换智谱 GLM 时改为：
#   LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
#   LLM_MODEL=glm-5  VLM_MODEL=glm-4v-plus  LLM_THINKING=disabled
LLM_API_KEY=
LLM_BASE_URL=https://api.siliconflow.cn/v1/
LLM_MODEL=zai-org/GLM-4.5-Air
VLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
# 思考开关：off=不发送该参数（硅基流动/百炼）；disabled=关闭思考（智谱 GLM）
# 注意：智谱 glm-5.3 系列"始终思考"，不能关，且 max_tokens 需 >= 2048 才有正文
LLM_THINKING=off
LLM_MAX_TOKENS=1024

# ===== 语音合成（TTS）=====
# 硅基流动 CosyVoice2；音色必须带模型前缀，可选：
#   claire 温柔女声 / diana 欢快女声 / anna 沉稳女声 / bella 激情女声
#   alex 沉稳男声 / benjamin 低沉男声 / charles 磁性男声 / david 欢快男声
# 换其他平台时改成该平台的 TTS 模型名；不需要朗读可留空（前端会自动隐藏朗读按钮）
TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
TTS_VOICE=FunAudioLLM/CosyVoice2-0.5B:claire
TTS_MAX_CHARS=300

# ===== 语音识别（ASR）=====
# 硅基流动 Qwen3-ASR（实测约 1 秒）；备选 FunAudioLLM/SenseVoiceSmall（较慢）
ASR_MODEL=Qwen/Qwen3-ASR-1.7B
ASR_MAX_BYTES=6000000

# auto: 有 Key 走真实模型；real: 强制真实；mock: 强制离线
LLM_MODE=auto

# ===== 服务 =====
HOST=127.0.0.1
PORT=8701

# ===== 会话与限流 =====
SESSION_TTL_SECONDS=3600
CONTEXT_MAX_TURNS=12
CONTEXT_MAX_CHARS=6000
RATE_LIMIT_PER_MINUTE=20

# 语音合成语速：0.85 = 慢 15%，听感更温柔；1.0 = 原速
TTS_SPEED=0.85
